+#ifdef __KERNEL__
+#include <linux/ioctl.h>
+#else
+#include <sys/ioctl.h>
+#endif
+
+
+#ifndef __QDMA_IOCTL_H__
+#define __QDMA_IOCTL_H__
+#include "qdma_persistent_uapi.h"
