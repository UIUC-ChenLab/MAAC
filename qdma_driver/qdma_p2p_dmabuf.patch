+/*
+ * cdev r/w
+ */
+static inline void iocb_release(struct qdma_io_cb *iocb)
+{
+	if (iocb->pages)
+		iocb->pages = NULL;
+	kfree(iocb->sgl);
+	iocb->sgl = NULL;
+	iocb->buf = NULL;
+}
+
+static long handle_p2p_dma(struct qdma_cdev *xcdev, unsigned long arg) {
+    ssize_t rv;
+
+    // Get P2P parameters
+    struct qdma_p2p_req p2p_req;
+    rv = copy_from_user(&p2p_req, (void __user *)arg, sizeof(p2p_req));
+    if (rv != 0) {
+        pr_warn("Failed to get P2P DMA request from userspace.\n");
+        return -EINVAL;
+    }
+
+    // Get the physical/low-level device
+    struct device *dev = &(xcdev->xcb->xpdev->pdev->dev);
+    struct dma_buf *dmabuf = dma_buf_get(p2p_req.dmabuf_fd);
+    struct dma_buf_attachment *dma_attach = dma_buf_attach(dmabuf, dev);
+    struct sg_table *sgt = dma_buf_map_attachment(dma_attach, DMA_BIDIRECTIONAL);
+
+    // Convert to QDMA's scatter list.
+    struct qdma_io_cb iocb;
+    rv = convert_sgl(sgt, &iocb, p2p_req.num_bytes);
+    if (rv != 0) {
+        return rv;
+    }
+
+    // Actually submit the data transfer.
+    u64 duration;
+    ssize_t bytes = submit_p2p_dma_request(xcdev, &p2p_req, &iocb, &duration);
+    p2p_req.response.bytes_transferred = bytes;
+    p2p_req.response.transfer_duration_ns = duration;
+
+    if (copy_to_user((void __user *)arg, &p2p_req, sizeof(p2p_req))) {
+        return -EFAULT;
+    }
+
+    iocb_release(&iocb);
+    dma_buf_unmap_attachment(dma_attach, sgt, DMA_BIDIRECTIONAL);
+    dma_buf_detach(dmabuf, dma_attach);
+    dma_buf_put(dmabuf);
+    return 0;
+}
+
+static ssize_t convert_sgl(struct sg_table *sgt, struct qdma_io_cb* iocb, unsigned int requested_bytes) {
+    struct qdma_sw_sg *qdma_sgl = kmalloc(sgt->nents * sizeof(struct qdma_sw_sg), GFP_KERNEL);
+    if (qdma_sgl == NULL) {
+        return -ENOMEM;
+    }
+    struct scatterlist *sg;
+    int i = 0;
+    const unsigned int num_entries = sgt->nents;
+    unsigned int bytes_remaining = requested_bytes;
+    
+    for_each_sg(sgt->sgl, sg, num_entries, i) {
+      qdma_sgl[i].next = ((i + 1) == sgt->nents) ? NULL : qdma_sgl + (i + 1);
+      qdma_sgl[i].pg = sg_page(sg);
+      qdma_sgl[i].offset = sg->offset;
+      
+      // Use the minimum of DMA length and remaining requested bytes
+      unsigned int sg_len = sg_dma_len(sg);
+      if (bytes_remaining > 0) {
+          qdma_sgl[i].len = min(sg_len, bytes_remaining);
+          bytes_remaining -= qdma_sgl[i].len;
+      } else {
+          qdma_sgl[i].len = 0;  // No more bytes to transfer
+      }
+      
+      qdma_sgl[i].dma_addr = sg_dma_address(sg);
+      
+      printk(KERN_DEBUG "convert_sgl: sg[%d] dma_len=%u, used_len=%u, remaining=%u\n", 
+             i, sg_len, qdma_sgl[i].len, bytes_remaining);
+    }
+    iocb->sgl = qdma_sgl;
+    iocb->pages_nr = num_entries;
+    return 0;
+}
+
+static ssize_t submit_p2p_dma_request(struct qdma_cdev *xcdev, struct qdma_p2p_req* p2p_req, struct qdma_io_cb *iocb, u64* duration_ns) {
+    struct qdma_request *dma_req = &(iocb->req);
+    dma_req->sgcnt = iocb->pages_nr;
+    dma_req->sgl = iocb->sgl;
+    dma_req->write = (p2p_req->direction == QDMA_P2P_WRITE) ? 1 : 0;
+    dma_req->dma_mapped = 1;
+    dma_req->udd_len = 0;
+    dma_req->ep_addr = (u64)(p2p_req->dev_addr);
+    dma_req->count = p2p_req->num_bytes;
+    dma_req->timeout_ms = 10 * 1000;	/* 10 seconds */
+    dma_req->fp_done = NULL;		/* blocking */
+    dma_req->h2c_eot = 1;		/* set to 1 for STM tests */
+
+    unsigned long qhndl = (p2p_req->direction == QDMA_P2P_WRITE) ? xcdev->h2c_qhndl : xcdev->c2h_qhndl;
+
+    u64 start = ktime_get_ns();
+    ssize_t rv = xcdev->fp_rw(xcdev->xcb->xpdev->dev_hndl, qhndl, dma_req);
+    u64 end = ktime_get_ns();
+
+    *duration_ns = end - start;
+    printk(KERN_INFO "submit_p2p_dma_request: request execution time: %llu ns. Length %lu bytes\n", end - start, rv);
+
+    return rv;
+}
+
+/* Multi-threaded P2P implementation */
+static ssize_t convert_sgl_for_chunk(struct sg_table *sgt, struct qdma_io_cb *iocb, 
+                                    unsigned int total_bytes, unsigned int chunk_offset, 
+                                    unsigned int chunk_size) {
+    struct qdma_sw_sg *qdma_sgl;
+    struct scatterlist *sg;
+    int i = 0;
+    unsigned int current_offset = 0;
+    unsigned int bytes_to_copy = chunk_size;
+    int valid_entries = 0;
+    
+    /* Allocate memory for scatter-gather list */
+    qdma_sgl = kmalloc(sgt->nents * sizeof(struct qdma_sw_sg), GFP_KERNEL);
+    if (!qdma_sgl) {
+        return -ENOMEM;
+    }
+    
+    /* Find the starting point and create SGL for this chunk */
+    for_each_sg(sgt->sgl, sg, sgt->nents, i) {
+        unsigned int sg_len = sg_dma_len(sg);
+        
+        /* Check if this chunk intersects with current SG entry */
+        if (current_offset < chunk_offset + chunk_size && current_offset + sg_len > chunk_offset) {
+            unsigned int sg_start_offset = 0;
+            unsigned int sg_bytes_to_use = sg_len;
+            
+            /* Adjust start offset if chunk starts in middle of this SG entry */
+            if (chunk_offset > current_offset) {
+                sg_start_offset = chunk_offset - current_offset;
+                sg_bytes_to_use -= sg_start_offset;
+            }
+            
+            /* Adjust bytes to use if chunk ends in middle of this SG entry */
+            if (current_offset + sg_len > chunk_offset + chunk_size) {
+                sg_bytes_to_use = chunk_offset + chunk_size - max(current_offset, chunk_offset);
+            }
+            
+            /* Limit to remaining bytes needed */
+            sg_bytes_to_use = min(sg_bytes_to_use, bytes_to_copy);
+            
+            if (sg_bytes_to_use > 0) {
+                qdma_sgl[valid_entries].next = (valid_entries == sgt->nents - 1) ? NULL : &qdma_sgl[valid_entries + 1];
+                qdma_sgl[valid_entries].pg = sg_page(sg);
+                qdma_sgl[valid_entries].offset = sg->offset + sg_start_offset;
+                qdma_sgl[valid_entries].len = sg_bytes_to_use;
+                qdma_sgl[valid_entries].dma_addr = sg_dma_address(sg) + sg_start_offset;
+                
+                bytes_to_copy -= sg_bytes_to_use;
+                valid_entries++;
+                
+                if (bytes_to_copy == 0) break;
+            }
+        }
+        current_offset += sg_len;
+        
+        if (current_offset >= chunk_offset + chunk_size) break;
+    }
+    
+    /* Fix the next pointers */
+    for (i = 0; i < valid_entries - 1; i++) {
+        qdma_sgl[i].next = &qdma_sgl[i + 1];
+    }
+    if (valid_entries > 0) {
+        qdma_sgl[valid_entries - 1].next = NULL;
+    }
+    
+    iocb->sgl = qdma_sgl;
+    iocb->pages_nr = valid_entries;
+    
+    printk(KERN_DEBUG "convert_sgl_for_chunk: chunk_offset=%u, chunk_size=%u, valid_entries=%d\n", 
+           chunk_offset, chunk_size, valid_entries);
+    
+    return 0;
+}
+
+static ssize_t submit_p2p_chunk_request(struct qdma_cdev *xcdev, struct qdma_p2p_req *p2p_req, 
+                                       struct qdma_io_cb *iocb, unsigned int chunk_offset, 
+                                       u64 *duration_ns) {
+    struct qdma_request *dma_req = &(iocb->req);
+    unsigned long qhndl;
+    ssize_t rv;
+    u64 start, end;
+    
+    /* Calculate actual transfer size from SGL */
+    unsigned int actual_transfer_size = 0;
+    struct qdma_sw_sg *sg = iocb->sgl;
+    while (sg) {
+        actual_transfer_size += sg->len;
+        sg = sg->next;
+    }
+    
+    /* Setup DMA request */
+    dma_req->sgcnt = iocb->pages_nr;
+    dma_req->sgl = iocb->sgl;
+    dma_req->write = (p2p_req->direction == QDMA_P2P_WRITE) ? 1 : 0;
+    dma_req->dma_mapped = 1;
+    dma_req->udd_len = 0;
+    dma_req->ep_addr = (u64)(p2p_req->dev_addr) + chunk_offset;  /* Offset the device address */
+    dma_req->count = actual_transfer_size;
+    dma_req->timeout_ms = 10 * 1000;  /* 10 seconds */
+    dma_req->fp_done = NULL;          /* blocking */
+    dma_req->h2c_eot = 1;            /* set to 1 for STM tests */
+    
+    qhndl = (p2p_req->direction == QDMA_P2P_WRITE) ? xcdev->h2c_qhndl : xcdev->c2h_qhndl;
+    
+    start = ktime_get_ns();
+    rv = xcdev->fp_rw(xcdev->xcb->xpdev->dev_hndl, qhndl, dma_req);
+    end = ktime_get_ns();
+    
+    *duration_ns = end - start;
+    
+    printk(KERN_INFO "submit_p2p_chunk_request: chunk_offset=%u, size=%u, time=%llu ns, result=%zd\n", 
+           chunk_offset, actual_transfer_size, *duration_ns, rv);
+    
+    return rv;
+}
+
+static int p2p_chunk_transfer_thread(void *data) {
+    struct p2p_chunk_data *chunk = (struct p2p_chunk_data *)data;
+    ssize_t rv;
+    
+    printk(KERN_INFO "P2P chunk thread %d starting: offset=%u, size=%u\n", 
+           chunk->thread_id, chunk->chunk_offset, chunk->chunk_size);
+    
+    chunk->start_time = ktime_get_ns();
+    
+    /* This thread will handle the chunk transfer */
+    chunk->error = 0;
+    chunk->bytes_transferred = 0;
+    
+    /* Submit the chunk transfer - this will block until completion */
+    u64 transfer_duration;
+    rv = submit_p2p_chunk_request(chunk->xcdev, chunk->p2p_req, &chunk->iocb, 
+                                 chunk->chunk_offset, &transfer_duration);
+    
+    chunk->end_time = ktime_get_ns();
+    
+    if (rv < 0) {
+        chunk->error = rv;
+        printk(KERN_ERR "P2P chunk thread %d failed: %zd\n", chunk->thread_id, rv);
+    } else {
+        chunk->bytes_transferred = rv;
+        printk(KERN_INFO "P2P chunk thread %d completed: %zd bytes in %llu ns\n", 
+               chunk->thread_id, rv, transfer_duration);
+    }
+    
+    /* Signal completion */
+    complete(&chunk->done);
+    return 0;
+}
+
+static long handle_p2p_dma_parallel(struct qdma_cdev *xcdev, unsigned long arg) {
+    struct qdma_p2p_req p2p_req;
+    struct p2p_parallel_ctx ctx;
+    struct device *dev;
+    struct dma_buf *dmabuf;
+    struct dma_buf_attachment *dma_attach;
+    struct sg_table *sgt;
+    ssize_t rv;
+    int i;
+    unsigned int chunk_size;
+    
+    /* Initialize context */
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.num_threads = 2;
+    
+    /* Get P2P parameters from user space */
+    rv = copy_from_user(&p2p_req, (void __user *)arg, sizeof(p2p_req));
+    if (rv != 0) {
+        pr_warn("Failed to get P2P DMA request from userspace.\n");
+        return -EINVAL;
+    }
+    
+    /* Check if transfer size is worth parallelizing */
+    if (p2p_req.num_bytes < 4 * 1024) {  /* 4KB threshold */
+        printk(KERN_INFO "P2P transfer size %u too small for parallel processing, using single thread\n", 
+               p2p_req.num_bytes);
+        return handle_p2p_dma(xcdev, arg);
+    }
+    
+    // printk(KERN_INFO "P2P parallel transfer starting: %u bytes with %d threads\n", 
+    //        p2p_req.num_bytes, ctx.num_threads);
+    
+    /* Get the physical/low-level device and setup DMA buf */
+    dev = &(xcdev->xcb->xpdev->pdev->dev);
+    dmabuf = dma_buf_get(p2p_req.dmabuf_fd);
+    if (IS_ERR(dmabuf)) {
+        return PTR_ERR(dmabuf);
+    }
+    
+    dma_attach = dma_buf_attach(dmabuf, dev);
+    if (IS_ERR(dma_attach)) {
+        dma_buf_put(dmabuf);
+        return PTR_ERR(dma_attach);
+    }
+    
+    sgt = dma_buf_map_attachment(dma_attach, DMA_BIDIRECTIONAL);
+    if (IS_ERR(sgt)) {
+        dma_buf_detach(dmabuf, dma_attach);
+        dma_buf_put(dmabuf);
+        return PTR_ERR(sgt);
+    }
+    
+    /* Calculate chunk size - split into 2 equal parts */
+    chunk_size = p2p_req.num_bytes / ctx.num_threads;
+    
+    ctx.total_start_time = ktime_get_ns();
+    
+    /* Initialize and start threads */
+    for (i = 0; i < ctx.num_threads; i++) {
+        struct p2p_chunk_data *chunk = &ctx.chunks[i];
+        
+        chunk->xcdev = xcdev;
+        chunk->p2p_req = &p2p_req;
+        chunk->chunk_offset = i * chunk_size;
+        /* Last chunk gets any remaining bytes */
+        chunk->chunk_size = (i == ctx.num_threads - 1) ? 
+                           (p2p_req.num_bytes - chunk->chunk_offset) : chunk_size;
+        chunk->thread_id = i;
+        chunk->error = 0;
+        chunk->bytes_transferred = 0;
+        
+        init_completion(&chunk->done);
+        
+        /* Convert SGL for this specific chunk */
+        rv = convert_sgl_for_chunk(sgt, &chunk->iocb, p2p_req.num_bytes, 
+                                  chunk->chunk_offset, chunk->chunk_size);
+        if (rv != 0) {
+            printk(KERN_ERR "Failed to convert SGL for chunk %d: %zd\n", i, rv);
+            ctx.total_error = rv;
+            goto cleanup_chunks;
+        }
+        
+        /* Create and start the thread */
+        ctx.threads[i] = kthread_run(p2p_chunk_transfer_thread, chunk, "p2p_chunk_%d", i);
+        if (IS_ERR(ctx.threads[i])) {
+            ctx.total_error = PTR_ERR(ctx.threads[i]);
+            printk(KERN_ERR "Failed to create thread %d: %ld\n", i, PTR_ERR(ctx.threads[i]));
+            goto cleanup_chunks;
+        }
+    }
+    
+    /* Wait for all threads to complete */
+    ctx.total_bytes = 0;
+    ctx.total_error = 0;
+    
+    for (i = 0; i < ctx.num_threads; i++) {
+        wait_for_completion(&ctx.chunks[i].done);
+        
+        if (ctx.chunks[i].error != 0) {
+            ctx.total_error = ctx.chunks[i].error;
+            printk(KERN_ERR "Chunk %d failed with error: %d\n", i, ctx.chunks[i].error);
+        } else {
+            ctx.total_bytes += ctx.chunks[i].bytes_transferred;
+        }
+    }
+    
+    ctx.total_end_time = ktime_get_ns();
+    
+    printk(KERN_INFO "P2P parallel transfer completed: %zd bytes in %llu ns\n", 
+           ctx.total_bytes, ctx.total_end_time - ctx.total_start_time);
+    
+cleanup_chunks:
+    /* Cleanup thread resources */
+    for (i = 0; i < ctx.num_threads; i++) {
+        if (ctx.chunks[i].iocb.sgl) {
+            kfree(ctx.chunks[i].iocb.sgl);
+        }
+    }
+    
+    /* Cleanup DMA resources */
+    dma_buf_unmap_attachment(dma_attach, sgt, DMA_BIDIRECTIONAL);
+    dma_buf_detach(dmabuf, dma_attach);
+    dma_buf_put(dmabuf);
+    
+    if (ctx.total_error == 0) {
+        /* Update response */
+        p2p_req.response.bytes_transferred = ctx.total_bytes;
+        p2p_req.response.transfer_duration_ns = ctx.total_end_time - ctx.total_start_time;
+        
+        if (copy_to_user((void __user *)arg, &p2p_req, sizeof(p2p_req))) {
+            return -EFAULT;
+        }
+        return 0;
+    }
+    
+    return ctx.total_error;
+}
+
+static void unmap_user_buf(struct qdma_io_cb *iocb, bool write)
+{
+	int i;
+
+	if (!iocb->pages || !iocb->pages_nr)
+		return;
+
+	for (i = 0; i < iocb->pages_nr; i++) {
+		if (iocb->pages[i]) {
+			if (!write)
+				set_page_dirty(iocb->pages[i]);
+			put_page(iocb->pages[i]);
+		} else
+			break;
+	}
+
+	if (i != iocb->pages_nr)
+		pr_err("sgl pages %d/%u.\n", i, iocb->pages_nr);
+
+	iocb->pages_nr = 0;
+}
+
+static int map_user_buf_to_sgl(struct qdma_io_cb *iocb, bool write)
+{
+	unsigned long len = iocb->len;
+	char *buf = iocb->buf;
+	struct qdma_sw_sg *sg;
+	unsigned int pg_off = offset_in_page(buf);
+	unsigned int pages_nr = (len + pg_off + PAGE_SIZE - 1) >> PAGE_SHIFT;
+	int i;
+	int rv;
+
+	if (len == 0)
+		pages_nr = 1;
+	if (pages_nr == 0)
+		return -EINVAL;
+
+	iocb->pages_nr = 0;
+	sg = kmalloc(pages_nr * (sizeof(struct qdma_sw_sg) +
+			sizeof(struct page *)), GFP_KERNEL);
+	if (!sg) {
+		pr_err("sgl allocation failed for %u pages", pages_nr);
+		return -ENOMEM;
+	}
+	memset(sg, 0, pages_nr * (sizeof(struct qdma_sw_sg) +
+			sizeof(struct page *)));
+	iocb->sgl = sg;
+
+	iocb->pages = (struct page **)(sg + pages_nr);
+	rv = get_user_pages_fast((unsigned long)buf, pages_nr, 1/* write */,
+				iocb->pages);
+	/* No pages were pinned */
+	if (rv < 0) {
+		pr_err("unable to pin down %u user pages, %d.\n",
+			pages_nr, rv);
+		goto err_out;
+	}
+	/* Less pages pinned than wanted */
+	if (rv != pages_nr) {
+		pr_err("unable to pin down all %u user pages, %d.\n",
+			pages_nr, rv);
+		iocb->pages_nr = rv;
+		rv = -EFAULT;
+		goto err_out;
+	}
+
+	for (i = 1; i < pages_nr; i++) {
+		if (iocb->pages[i - 1] == iocb->pages[i]) {
+			pr_err("duplicate pages, %d, %d.\n",
+				i - 1, i);
+			iocb->pages_nr = pages_nr;
+			rv = -EFAULT;
+			goto err_out;
+		}
+	}
+
+	sg = iocb->sgl;
+	for (i = 0; i < pages_nr; i++, sg++) {
+		unsigned int offset = offset_in_page(buf);
+		unsigned int nbytes = min_t(unsigned int, PAGE_SIZE - offset,
+						len);
+		struct page *pg = iocb->pages[i];
+
+		flush_dcache_page(pg);
+
+		sg->next = sg + 1;
+		sg->pg = pg;
+		sg->offset = offset;
+		sg->len = nbytes;
+		sg->dma_addr = 0UL;
+
+		buf += nbytes;
+		len -= nbytes;
+	}
+
+	iocb->sgl[pages_nr - 1].next = NULL;
+	iocb->pages_nr = pages_nr;
+	return 0;
+
+err_out:
+	unmap_user_buf(iocb, write);
+	iocb_release(iocb);
+
+	return rv;
+}
+
+static ssize_t cdev_gen_read_write(struct file *file, char __user *buf,
+		size_t count, loff_t *pos, bool write)
+{
+	struct qdma_cdev *xcdev = (struct qdma_cdev *)file->private_data;
+	struct qdma_io_cb iocb;
+	struct qdma_request *req = &iocb.req;
+	ssize_t res = 0;
+	int rv;
+	unsigned long qhndl;
+
+	if (!xcdev) {
+		pr_err("file 0x%p, xcdev NULL, 0x%p,%llu, pos %llu, W %d.\n",
+			file, buf, (u64)count, (u64)*pos, write);
+		return -EINVAL;
+	}
+
+	if (!xcdev->fp_rw) {
+		pr_err("file 0x%p, %s, NO rw, 0x%p,%llu, pos %llu, W %d.\n",
+			file, xcdev->name, buf, (u64)count, (u64)*pos, write);
+		return -EINVAL;
+	}
+
+	qhndl = write ? xcdev->h2c_qhndl : xcdev->c2h_qhndl;
+
+	pr_debug("%s, priv 0x%lx: buf 0x%p,%llu, pos %llu, W %d.\n",
+		xcdev->name, qhndl, buf, (u64)count, (u64)*pos,
+		write);
+
+	memset(&iocb, 0, sizeof(struct qdma_io_cb));
+	iocb.buf = buf;
+	iocb.len = count;
+	rv = map_user_buf_to_sgl(&iocb, write);
+	if (rv < 0)
+		return rv;
+
+	req->sgcnt = iocb.pages_nr;
+	req->sgl = iocb.sgl;
+	req->write = write ? 1 : 0;
+	req->dma_mapped = 0;
+	req->udd_len = 0;
+	req->ep_addr = (u64)*pos;
+	req->count = count;
+	req->timeout_ms = 10 * 1000;	/* 10 seconds */
+	req->fp_done = NULL;		/* blocking */
+	req->h2c_eot = 1;		/* set to 1 for STM tests */
+
+	res = xcdev->fp_rw(xcdev->xcb->xpdev->dev_hndl, qhndl, req);
+
+	unmap_user_buf(&iocb, write);
+	iocb_release(&iocb);
+
+	return res;
+}
+
+static ssize_t cdev_gen_write(struct file *file, const char __user *buf,
+				size_t count, loff_t *pos)
+{
+	return cdev_gen_read_write(file, (char *)buf, count, pos, 1);
+}
+
+static ssize_t cdev_gen_read(struct file *file, char __user *buf,
+				size_t count, loff_t *pos)
+{
+	return cdev_gen_read_write(file, (char *)buf, count, pos, 0);
+}
+
+static ssize_t cdev_aio_write(struct kiocb *iocb, const struct iovec *io,
+				unsigned long count, loff_t pos)
+{
+	struct qdma_cdev *xcdev =
+		(struct qdma_cdev *)iocb->ki_filp->private_data;
+	struct cdev_async_io *caio;
+	int rv = 0;
+	unsigned long i;
+	unsigned long qhndl;
+
+	if (!xcdev) {
+		pr_err("file 0x%p, xcdev NULL, %llu, pos %llu, W %d.\n",
+				iocb->ki_filp, (u64)count, (u64)pos, 1);
+		return -EINVAL;
+	}
+
+	if (!xcdev->fp_rw) {
+		pr_err("No Read write handler assigned\n");
+		return -EINVAL;
+	}
+
+	caio = kmem_cache_alloc(cdev_cache, GFP_KERNEL);
+	if (!caio) {
+		pr_err("Failed to allocate caio");
+		return -ENOMEM;
+	}
+	memset(caio, 0, sizeof(struct cdev_async_io));
+	caio->qiocb = kzalloc(count * (sizeof(struct qdma_io_cb) +
+			sizeof(struct qdma_request *)), GFP_KERNEL);
+	if (!caio->qiocb) {
+		pr_err("failed to allocate qiocb");
+		return -ENOMEM;
+	}
+
+	caio->reqv = (struct qdma_request **)(caio->qiocb + count);
+	for (i = 0; i < count; i++) {
+		caio->qiocb[i].private = caio;
+		caio->reqv[i] = &(caio->qiocb[i].req);
+		caio->qiocb[i].buf = io[i].iov_base;
+		caio->qiocb[i].len = io[i].iov_len;
+		rv = map_user_buf_to_sgl(&(caio->qiocb[i]), true);
+		if (rv < 0)
+			break;
+
+		caio->reqv[i]->write = 1;
+		caio->reqv[i]->sgcnt = caio->qiocb[i].pages_nr;
+		caio->reqv[i]->sgl = caio->qiocb[i].sgl;
+		caio->reqv[i]->dma_mapped = false;
+		caio->reqv[i]->udd_len = 0;
+		caio->reqv[i]->ep_addr = (u64)pos;
+		pos += io[i].iov_len;
+		caio->reqv[i]->no_memcpy = xcdev->no_memcpy ? 1 : 0;
+		caio->reqv[i]->count = io->iov_len;
+		caio->reqv[i]->timeout_ms = 10 * 1000;	/* 10 seconds */
+		caio->reqv[i]->fp_done = qdma_req_completed;
+
+	}
+	if (i > 0) {
+		iocb->private = caio;
+		caio->iocb = iocb;
+		caio->req_count = i;
+		qhndl = xcdev->h2c_qhndl;
+		rv = xcdev->fp_aiorw(xcdev->xcb->xpdev->dev_hndl, qhndl,
+				     caio->req_count, caio->reqv);
+		if (rv >= 0)
+			rv = -EIOCBQUEUED;
+	} else {
+		pr_err("failed with %d for %lu reqs", rv, caio->req_count);
+		kfree(caio->qiocb);
+		kmem_cache_free(cdev_cache, caio);
+	}
+
+	return rv;
+}
+
