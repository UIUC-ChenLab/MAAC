+		caio->req_count = i;
+		qhndl = xcdev->c2h_qhndl;
+		rv = xcdev->fp_aiorw(xcdev->xcb->xpdev->dev_hndl, qhndl,
+				     caio->req_count, caio->reqv);
+		if (rv >= 0)
+			rv = -EIOCBQUEUED;
+	} else {
+		pr_err("failed with %d for %lu reqs", rv, caio->req_count);
+		kfree(caio->qiocb);
+		kmem_cache_free(cdev_cache, caio);
+	}
+
+	return rv;
+}
